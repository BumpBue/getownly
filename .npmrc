# Keep the dependency tree strict so a package must declare what it imports.
strict-peer-dependencies=false
auto-install-peers=true

# eslint-config-next pulls its plugins in as transitive dependencies and resolves
# them from the project root, which pnpm's strict layout hides. Hoisting anything
# eslint-related makes `pnpm lint` work in the frontend workspace.
public-hoist-pattern[]=*eslint*
