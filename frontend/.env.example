# ---------------------------------------------------------------------------
# getownly web - copy this file to frontend/.env.local
#
# Anything prefixed with NEXT_PUBLIC_ is inlined into the browser bundle.
# Never put a secret behind that prefix.
# ---------------------------------------------------------------------------

# Base URL the browser uses to call the API. Must match FRONTEND_ORIGIN's
# counterpart in backend/.env so that httpOnly cookies are accepted.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Base URL the API is reached at from inside Server Components / route handlers.
# Same value in local development; differs once the API runs in its own container.
API_BASE_URL=http://localhost:4000/api

# Absolute URL of this web app. Used to build links inside emails and
# certificate verification pages.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown in the footer and on printable documents.
NEXT_PUBLIC_SITE_NAME=getownly

# Where MinIO actually is, so next/image is allowed to load the signed URLs
# backend/.env's MINIO_ENDPOINT/MINIO_PORT/MINIO_USE_SSL hand out for course
# covers. Keep these three in sync with that file - the browser loads the
# image directly from this host, not through the API.
NEXT_PUBLIC_MINIO_ENDPOINT=localhost
NEXT_PUBLIC_MINIO_PORT=9000
NEXT_PUBLIC_MINIO_USE_SSL=false
