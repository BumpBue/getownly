# ---------------------------------------------------------------------------
# getownly API - copy this file to backend/.env and adjust as needed.
# The values below match docker-compose.yml, so a fresh clone works unchanged.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# --- runtime ---------------------------------------------------------------
# development | production | test
NODE_ENV=development
# Port the NestJS server listens on.
PORT=4000
# Prefix in front of every route, e.g. http://localhost:4000/api/health
API_PREFIX=api

# --- database --------------------------------------------------------------
# PostgreSQL connection string used by Prisma (user:password@host:port/database).
# Port 5433 is what docker-compose.yml publishes, chosen so a PostgreSQL already
# installed on the machine (which usually holds 5432) cannot shadow the container.
DATABASE_URL="postgresql://getownly:getownly_dev_password@localhost:5433/getownly?schema=public"

# --- authentication --------------------------------------------------------
# Signing secrets for the JWTs this API issues. MUST be different from each other
# and MUST be replaced with long random strings before any real deployment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev_access_secret_change_me_before_production
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_before_production
# Lifetimes. Short access token, long refresh token that rotates on every use.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Cookie settings. Use 'none' + COOKIE_SECURE=true only when the API is on HTTPS.
# There is deliberately no COOKIE_DOMAIN: omitting the attribute scopes the
# cookie to the exact host that set it, which is what we want everywhere.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# bcrypt work factor. 12 costs roughly 200ms per hash, which is the point.
BCRYPT_COST=12
# How long a password reset link stays usable, in minutes.
PASSWORD_RESET_EXPIRES_MINUTES=60

# --- rate limiting ---------------------------------------------------------
# Counted per IP address. Login is the brute-force target; forgot-password is
# the email-spam target, so it gets a much longer window.
RATE_LIMIT_LOGIN_LIMIT=5
RATE_LIMIT_LOGIN_TTL_SECONDS=60
RATE_LIMIT_FORGOT_PASSWORD_LIMIT=3
RATE_LIMIT_FORGOT_PASSWORD_TTL_SECONDS=3600

# --- frontend origin -------------------------------------------------------
# Allowed CORS origin. Cookies only travel if this matches the browser origin exactly.
FRONTEND_ORIGIN=http://localhost:3000

# --- object storage (MinIO) ------------------------------------------------
# S3 API endpoint of the MinIO container.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=getownly
MINIO_SECRET_KEY=getownly_dev_password
# Bucket created automatically by the minio-init service in docker-compose.yml.
MINIO_BUCKET=getownly-media
# Where the BROWSER reaches MinIO. Presigned URLs are signed over this host, so
# it must be an address a person's browser can open — which is not always the
# same as the one above. On this machine they match; inside
# `docker compose --profile full` the API talks to `minio` while the browser
# still talks to `localhost`. There is no default: a wrong value here breaks
# nothing until somebody uploads a file.
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false
# How long a presigned READ url stays valid, in seconds. One hour.
# Lesson videos never get one of these: they are streamed through the API.
MINIO_PRESIGN_EXPIRY_SECONDS=3600
# How long a presigned UPLOAD url stays valid. Long enough for a 150MB video
# on a slow connection, short enough that a leaked url is not a standing door.
MINIO_PRESIGN_UPLOAD_EXPIRY_SECONDS=900

# --- upload limits ---------------------------------------------------------
# Not configurable, and deliberately not here. File size ceilings and the
# per-course storage quota are fixed by the scope document (ทก.01 A6:
# video 150 MB per clip, 1 GB per course) and live in
# packages/shared/src/limits.ts, so the API and the web app enforce one number.
# Setting UPLOAD_MAX_* here has no effect.

# --- email (Mailhog in development) ----------------------------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
# Mailhog accepts any credentials; leave blank in development.
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=getownly
MAIL_FROM_ADDRESS=no-reply@getownly.local

# --- platform business rules ----------------------------------------------
# Fallback commission rate when a user has no individual rate set.
# 0.30 means the platform keeps 30% and the instructor earns 70%.
PLATFORM_DEFAULT_COMMISSION_RATE=0.30
# PromptPay target that the top-up QR code pays into.
# Phone number (10 digits) or national ID / tax ID (13 digits).
#
# !!! WARNING !!!  The value below is a placeholder made of zeroes on purpose.
# A real PromptPay ID here means every QR this system prints asks strangers to
# send money to that account. Do not put a working number in a file that gets
# committed, screenshotted, or handed in with a thesis. Put yours in
# backend/.env (which is gitignored) only when you actually need to scan-test.
PROMPTPAY_ID=0000000000
# Shown next to the QR so the payer can see who they are paying.
PROMPTPAY_DISPLAY_NAME=GETOWNLY PLATFORM (สาธิต)
# true prints "QR สำหรับสาธิตระบบ กรุณาอย่าโอนเงินจริง" beside every QR code.
# Leave it true unless a real PromptPay ID is configured above.
DEMO_MODE=true
# Guard rails for a single top-up request, in baht.
TOPUP_MIN_AMOUNT=20
TOPUP_MAX_AMOUNT=50000
# How long the QR shown on screen is presented as valid, in minutes. Advisory
# only: nothing is reserved, and the slip is what an admin actually reviews.
TOPUP_QUOTE_EXPIRY_MINUTES=15

# --- seed accounts ---------------------------------------------------------
# Credentials the seed script creates. Development only.
SEED_ADMIN_EMAIL=admin@getownly.local
SEED_ADMIN_PASSWORD=Admin@1234
SEED_DEFAULT_PASSWORD=Password@1234
